---
import "../styles.css";
import { copy } from "../lib/content";
import { jsonLdForPage, seoFor, SITE_URL, type SeoPage } from "../lib/seo";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Lightbox from "../components/Lightbox.astro";

interface Props {
  page?: SeoPage;
  title?: string;
  description?: string;
  robots?: string;
  overHero?: boolean;
}

const page = Astro.props.page;
const seoEn = page ? seoFor(page, "en") : null;
const seoEs = page ? seoFor(page, "es") : null;
const title = Astro.props.title ?? seoEn?.title ?? copy.en.metaTitle;
const description =
  Astro.props.description ?? seoEn?.description ?? copy.en.metaDescription;
const titleEs = seoEs?.title ?? copy.es.metaTitle;
const descEs = seoEs?.description ?? copy.es.metaDescription;
const robots =
  Astro.props.robots ?? "index, follow, max-image-preview:large";
const canonical = new URL(seoEn?.path ?? Astro.url.pathname, SITE_URL).href;
const og = new URL("/og.jpg", SITE_URL).href;
const jsonLd = page ? JSON.stringify(jsonLdForPage(page, "en")) : null;
const overHero = Astro.props.overHero ?? false;
---

<!doctype html>
<html
  lang="en"
  data-title-en={title}
  data-title-es={titleEs}
  data-desc-en={description}
  data-desc-es={descEs}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {
      overHero ? (
        <link
          rel="preload"
          as="image"
          type="image/webp"
          href="/images/opt/hero-720.webp"
          fetchpriority="high"
        />
      ) : null
    }
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Nina Romero" />
    <meta name="theme-color" content="#F4EDE4" />
    <meta name="robots" content={robots} />
    <meta name="googlebot" content="max-image-preview:large" />
    <meta name="geo.region" content="US-NM" />
    <meta name="geo.placename" content="Albuquerque" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Nina Romero" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:locale:alternate" content="es_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={copy.en.ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    <meta name="twitter:image:alt" content={copy.en.ogAlt} />
  </head>
  <body class="antialiased" data-page={page ?? ""}>
    <Header overHero={overHero} />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    <Lightbox />
    {jsonLd ? <script is:inline type="application/ld+json" set:html={jsonLd} /> : null}
    <script src="../scripts/site.ts"></script>
  </body>
</html>
