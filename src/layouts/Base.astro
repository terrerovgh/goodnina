---
import "../styles.css";
import { copy } from "../lib/content";
import { jsonLdForPage, seoFor, SITE_URL, type SeoPage } from "../lib/seo";

interface Props {
  page?: SeoPage;
  title?: string;
  description?: string;
  robots?: string;
}

const page = Astro.props.page;
const seo = page ? seoFor(page, "en") : null;
const title = Astro.props.title ?? seo?.title ?? copy.en.metaTitle;
const description =
  Astro.props.description ?? seo?.description ?? copy.en.metaDescription;
const robots =
  Astro.props.robots ?? "index, follow, max-image-preview:large";
const canonical = new URL(seo?.path ?? Astro.url.pathname, SITE_URL).href;
const og = new URL("/og.jpg", SITE_URL).href;
const jsonLd = page ? JSON.stringify(jsonLdForPage(page, "en")) : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Nina Romero" />
    <meta name="theme-color" content="#F4EDE4" />
    <meta name="robots" content={robots} />
    <meta name="googlebot" content="max-image-preview:large" />
    <meta name="geo.region" content="US-NM" />
    <meta name="geo.placename" content="Albuquerque" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Nina Romero" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:locale:alternate" content="es_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={copy.en.ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    <meta name="twitter:image:alt" content={copy.en.ogAlt} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&family=Outfit:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
    {jsonLd ? (
      <script is:inline type="application/ld+json" set:html={jsonLd} />
    ) : null}
  </head>
  <body class="antialiased">
    <slot />
  </body>
</html>
