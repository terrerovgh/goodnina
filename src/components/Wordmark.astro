---
interface Props {
  class?: string;
}
const extra = Astro.props.class ?? "";
---

<a
  href="/"
  class:list={["group wordmark flex items-center gap-2.5 no-underline", extra]}
  aria-label="Nina Romero — home"
>
  <span class="wordmark-icon grid size-8 place-items-center text-ink" aria-hidden="true">
    <svg viewBox="0 0 32 32" class="size-7" fill="none">
      <g
        stroke="currentColor"
        stroke-width="1.15"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M16 27 V14.2"></path>
        <path d="M16 14.2 C16 14.2 9.8 8.8 12.1 5.6 C14.2 8.3 16 10 16 10"></path>
        <path d="M16 14.2 C16 14.2 22.2 8.8 19.9 5.6 C17.8 8.3 16 10 16 10"></path>
        <path d="M16 16.2 C16 16.2 8.6 15 8.6 11.6 C12 13.4 15.2 15.2 16 16.2"></path>
        <path d="M16 16.2 C16 16.2 23.4 15 23.4 11.6 C20 13.4 16.8 15.2 16 16.2"></path>
        <circle cx="16" cy="11" r="1.05" fill="currentColor" stroke="none"></circle>
      </g>
    </svg>
  </span>
  <span
    class="wordmark-name font-display text-xl font-medium tracking-tight leading-none text-ink sm:text-2xl"
  >
    Nina Romero
  </span>
</a>
