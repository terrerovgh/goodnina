---
import { copy } from "../lib/content";
const en = copy.en;
const es = copy.es;
---

<section class="relative isolate min-h-svh overflow-hidden bg-ink">
  <picture>
    <source
      media="(min-width: 640px)"
      srcset="/images/opt/hero-1280.webp"
      type="image/webp"
    />
    <img
      src="/images/opt/hero-720.webp"
      alt="Nina Romero, fine line tattoo artist in Albuquerque, among daisies and chrysanthemums"
      data-alt-en="Nina Romero, fine line tattoo artist in Albuquerque, among daisies and chrysanthemums"
      data-alt-es="Nina Romero, tatuadora fine line en Albuquerque, entre margaritas y crisantemos"
      width="720"
      height="480"
      fetchpriority="high"
      decoding="async"
      class="hero-photo h-svh w-full object-cover"
    />
  </picture>
  <div
    class="pointer-events-none absolute inset-0 bg-gradient-to-t from-ink/70 via-ink/10 to-ink/20"
    aria-hidden="true"
  >
  </div>
  <div class="absolute inset-0 z-10 flex flex-col justify-end px-5 pb-16 pt-28 sm:px-10 sm:pb-20 lg:px-16">
    <p class="kicker text-on-photo/80" data-en={en.hero.kicker} data-es={es.hero.kicker}>{en.hero.kicker}</p>
    <h1
      class="mt-3 max-w-5xl font-display text-display font-medium leading-display tracking-tight text-on-photo italic"
      data-en={en.hero.title}
      data-es={es.hero.title}
    >
      {en.hero.title}
    </h1>
    <p
      class="mt-5 font-sans text-sm font-medium tracking-kicker text-on-photo/85 uppercase sm:text-base"
      data-en={en.hero.lede}
      data-es={es.hero.lede}
    >
      {en.hero.lede}
    </p>
  </div>
</section>
